#!/usr/bin/env python3
"""Fake nvidia-smi for the offload-matrix tier-1 suite.

Implements exactly the invocations our suites make, and nothing else:

  nvidia-smi -L
      -> one "GPU <n>: <name> (UUID: ...)" line per GPU. Added alongside the club-3090#1279 fix:
         p2p_gpu_count() counts these, and WITHOUT this arm it returned 0 here,
         which routed bench.sh's interconnect block down the single-card path.
         test-bench-capture had been passing anyway, because the OLD
         p2p_gpu_count returned the two-line string "0\n0" and `[[ "0\n0" -lt 2 ]]`
         is a SHELL SYNTAX ERROR — the `if` went false and execution fell
         through to the multi-GPU branch by accident. Fixing that bug (#1279)
         exposed the missing arm.

  nvidia-smi [-i LIST] --query-gpu=<f1>[,<f2>...] --format=csv,noheader,nounits
      -> one row per GPU, fields joined by ", " (index, memory.used,
         utilization.gpu; any other field reads 0). `-i` keeps only the listed
         indices / GPU-fake UUIDs, and a list naming no fake GPU prints
         "No devices were found" on stdout and exits 6, as the real tool does
         (capture.sh's BENCH_GPUS).

  nvidia-smi dmon [-i LIST] -s ut -d 1 [-c N]
      -> the 9-column utilisation/PCIe stream. The sweep averages it with
         awk '!/^#/ && NF>=9 {s+=$2;m+=$3;r+=$8;t+=$9}', i.e.
         $2=sm%  $3=memctl%  $8=rxpci MB/s  $9=txpci MB/s
         Fewer than 9 fields on a data line and every bandwidth column
         silently becomes '-', so the width matters.

Knobs (env):
  FAKE_NGPU        number of GPUs (default 2)
  FAKE_VRAM_MIB    comma list of per-GPU memory.used, or one value for all
  FAKE_SM / FAKE_MEMCTL / FAKE_RXPCI / FAKE_TXPCI   dmon values
"""
import os, sys, time

NGPU = int(os.environ.get("FAKE_NGPU", "2"))

def vram_list():
    raw = os.environ.get("FAKE_VRAM_MIB", "12000")
    vals = [v.strip() for v in raw.split(",") if v.strip()]
    return (vals * NGPU)[:NGPU] if len(vals) < NGPU else vals[:NGPU]

argv = sys.argv[1:]

def selected():
    """GPU indices `-i` selects (all without it)."""
    if "-i" not in argv:
        return list(range(NGPU))
    want = argv[argv.index("-i") + 1].split(",")
    uuids = {"GPU-fake%08d" % i: i for i in range(NGPU)}
    out = []
    for w in want:
        if w.isdigit() and int(w) < NGPU:
            out.append(int(w))
        elif w in uuids:
            out.append(uuids[w])
    return sorted(set(out))

SEL = selected()
if "-i" in argv and not SEL:
    print("No devices were found")
    sys.exit(6)

# --- device list form (`nvidia-smi -L`) ---
if argv and argv[0] == "-L":
    for i in SEL:
        print("GPU %d: NVIDIA GeForce RTX 3090 (UUID: GPU-fake%08d)" % (i, i))
    raise SystemExit(0)

# --- query-gpu form ---
if any(a.startswith("--query-gpu") for a in argv):
    fields = next(a for a in argv if a.startswith("--query-gpu")).split("=", 1)[1].split(",")
    vram = vram_list()
    for i in SEL:
        row = []
        for f in fields:
            if f == "index":
                row.append(str(i))
            elif f == "memory.used":
                row.append(vram[i])
            elif f == "utilization.gpu":
                row.append(os.environ.get("FAKE_SM", "40"))
            else:
                row.append("0")
        print(", ".join(row))
    sys.exit(0)

# --- dmon form ---
if "dmon" in argv:
    count = None
    if "-c" in argv:
        try: count = int(argv[argv.index("-c") + 1])
        except Exception: count = None
    delay = 1
    if "-d" in argv:
        try: delay = int(argv[argv.index("-d") + 1])
        except Exception: delay = 1

    sm  = os.environ.get("FAKE_SM", "40")
    mem = os.environ.get("FAKE_MEMCTL", "25")
    rx  = os.environ.get("FAKE_RXPCI", "1200")
    tx  = os.environ.get("FAKE_TXPCI", "800")

    print("# gpu    sm   mem   enc   dec   jpg   ofa  rxpci  txpci", flush=True)
    print("# Idx     %     %     %     %     %     %   MB/s   MB/s", flush=True)
    n = 0
    try:
        while count is None or n < count:
            for g in SEL:
                # 9 fields exactly — the sweep requires NF>=9
                print(f"{g:5d} {sm:>5} {mem:>5} {0:5d} {0:5d} {0:5d} {0:5d} {rx:>6} {tx:>6}", flush=True)
            n += 1
            if count is None or n < count:
                time.sleep(delay)
    except (KeyboardInterrupt, BrokenPipeError):
        pass
    sys.exit(0)

# anything else: behave like a tool that exists but was asked something unknown
sys.exit(0)
