# club3090-model-switch.service — HTTP control plane for swapping the served model.
# ---------------------------------------------------------------------------
# Runs tools/model-switch/server.py as a host daemon (it drives `docker compose`
# via scripts/switch.sh, so it runs on the HOST, not in a container).
#
# Install (edit the two rig-specific values first — User= and the repo path):
#
#   sed -e "s|/opt/club-3090|$PWD|g" -e "s|User=youruser|User=$USER|" \
#       scripts/systemd/club3090-model-switch.service | sudo tee /etc/systemd/system/club3090-model-switch.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now club3090-model-switch.service
#
# The token + model port (CLUB3090_API_TOKEN / VLLM_API_KEY, PORT, MODEL_DIR, …) come
# from the club-3090 settings: server.py and switch.sh load them themselves through
# the one loader (club-3090#1466) — ~/.config/club-3090/ of the User= below (systemd
# sets HOME for it), then the repo-root .env — so the service sees what the CLI sees.
[Unit]
Description=club-3090 model-switch HTTP control plane
After=docker.service
Wants=docker.service

[Service]
Type=simple
# The account that owns the repo checkout AND is in the `docker` group.
User=youruser
WorkingDirectory=/opt/club-3090
# No EnvironmentFile: settings are loaded by server.py itself (see above). An
# installed copy of the older unit, which had EnvironmentFile=<repo>/.env, keeps
# working, but its values count as "shell" and outrank ~/.config/club-3090/ —
# re-install the unit to drop it.
ExecStart=/usr/bin/python3 /opt/club-3090/tools/model-switch/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
