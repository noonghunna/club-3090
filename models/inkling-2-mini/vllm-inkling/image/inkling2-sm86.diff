+def moe_align_block_size_torch(
+    topk_ids, block_size: int, num_experts: int, expert_map=None, pad_sorted_ids: bool = False,
+    ignore_invalid_experts: bool = False, return_scatter_idx: bool = False,
+):
+    """club-3090 sm86 overlay: torch stand-in for vLLM's `moe_align_block_size`, whose CUDA kernel this image
+    builds for sm_100 only (on sm_86 the op returns its buffers unwritten). Same buffers and contract for
+    the `ignore_invalid_experts=True`, no `expert_map` call that the Humming experts make: ids outside
+    [0, num_experts) are skipped, each expert's rows are padded to `block_size` with `topk_ids.numel()`,
+    and `expert_ids` names each block's expert. No host syncs, so CUDA graphs can capture it."""
+    import torch
+    from vllm.triton_utils import triton
+    from vllm.utils.math_utils import round_up
+
+    assert expert_map is None and ignore_invalid_experts and not return_scatter_idx, "sm86 stand-in: Humming's call only"
+    numel = topk_ids.numel()
+    device = topk_ids.device
+    max_padded = numel + num_experts * (block_size - 1)
+    if pad_sorted_ids:
+        max_padded = round_up(max_padded, block_size)
+    if numel < num_experts:
+        max_padded = min(numel * block_size, max_padded)
+    max_blocks = triton.cdiv(max_padded, block_size)
+    flat = topk_ids.reshape(-1).to(torch.int64)
+    valid = (flat >= 0) & (flat < num_experts)
+    key = torch.where(valid, flat, torch.full_like(flat, num_experts))  # invalid rows sort last
+    counts = torch.zeros(num_experts + 1, dtype=torch.int64, device=device)
+    counts.scatter_add_(0, key, torch.ones_like(key))
+    counts = counts[:num_experts]
+    padded = (counts + block_size - 1) // block_size * block_size
+    padded_end = torch.cumsum(padded, 0)
+    padded_start = padded_end - padded
+    raw_start = torch.cumsum(counts, 0) - counts
+    order = torch.sort(key, stable=True).indices                  # rows grouped by expert, in row order
+    sorted_key = key[order]
+    rank = torch.arange(numel, device=device) - raw_start.index_select(0, sorted_key.clamp(max=num_experts - 1))
+    dest = padded_start.index_select(0, sorted_key.clamp(max=num_experts - 1)) + rank
+    dest = torch.where(sorted_key < num_experts, dest, torch.full_like(dest, max_padded))  # invalid -> dump slot
+    sorted_ids = torch.full((max_padded + 1,), numel, dtype=torch.int32, device=device)
+    sorted_ids.scatter_(0, dest, order.to(torch.int32))
+    block_start = torch.arange(max_blocks, device=device, dtype=torch.int64) * block_size
+    expert_ids = torch.searchsorted(padded_end, block_start, right=True).clamp(max=num_experts - 1).to(torch.int32)
+    num_tokens_post_pad = padded_end[-1:].to(torch.int32)
+    return sorted_ids[:max_padded], expert_ids, num_tokens_post_pad
