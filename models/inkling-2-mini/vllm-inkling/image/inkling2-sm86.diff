+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""club-3090 sm86 overlay: E4M3 KV cache conversions in software, for GPUs below
+sm_89 (Ampere).
+
+The FP8 KV cache of Inkling2 is unit-scale E4M3 (K is L2-clipped and V RMS-normed
+before the store, so values stay far inside +-448). Upstream converts with PTX
+(`cvt.rn.f16x2.e4m3x2` on load, Triton's fp8e4nv cast on store), and Triton refuses
+fp8e4nv pointers and casts below sm_89. Here the cache is handed to the kernels as
+uint8 and converted with integer ops:
+
+* load:  E4M3 -> FP16 exactly. The 7 magnitude bits shifted left by 7 are an FP16
+  whose value is the E4M3 value times 2^-8 (exponent bias 7 vs 15, and both formats
+  have subnormals), so multiplying by 2^8 is exact. 0x7F / 0xFF are NaN.
+* store: FP32 -> E4M3 with round-to-nearest-even and saturation to +-448 (the
+  semantics of `cvt.rn.satfinite.e4m3x2.f32`); NaN -> 0x7F.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+from . import pre_hopper
+
+
+def kv_cache_for_kernels(cache: torch.Tensor) -> torch.Tensor:
+    """Below sm_89 an E4M3 cache goes to the Triton kernels as its bytes."""
+    if cache.dtype == torch.float8_e4m3fn and pre_hopper():
+        return cache.view(torch.uint8)
+    return cache
+
+
+@triton.jit
+def e4m3_bits_to_f16(b):
+    """FP16 value of the E4M3 byte(s) `b` (any integer dtype; low 8 bits used)."""
+    b = b.to(tl.uint16) & 0xFF
+    mag = b & 0x7F
+    h = ((mag << 7) | ((b & 0x80) << 8)).to(tl.float16, bitcast=True)
+    v = h.to(tl.float32) * 256.0
+    v = tl.where(mag == 0x7F, float("nan"), v)
+    return v.to(tl.float16)
+
+
+@triton.jit
+def f32_to_e4m3_bits(x):
+    """E4M3 byte of fp32 `x`: round to nearest even, saturate to +-448, NaN -> 0x7F."""
+    x = x.to(tl.float32)
+    bits = x.to(tl.uint32, bitcast=True)
+    sign = (bits >> 24) & 0x80
+    a = tl.minimum(tl.abs(x), 448.0)
+    abits = a.to(tl.uint32, bitcast=True)
+    e32 = (abits >> 23).to(tl.int32) - 127
+    # Normal range (a >= 2^-6): keep the top 3 mantissa bits, round the other 20.
+    m23 = abits & 0x7FFFFF
+    keep = m23 >> 20
+    rem = m23 & 0xFFFFF
+    up = (rem > 0x80000) | ((rem == 0x80000) & ((keep & 1) == 1))
+    normal = ((tl.maximum(e32 + 7, 0)).to(tl.uint32) << 3) + keep + up.to(tl.uint32)
+    # Subnormal range (a < 2^-6): the byte is a / 2^-9 rounded to nearest even; 8
+    # (the rounding carry) is the smallest normal, 2^-6, so it needs no special case.
+    s = a * 512.0
+    f = tl.floor(s)
+    d = s - f
+    fi = f.to(tl.uint32)
+    sub = fi + ((d > 0.5) | ((d == 0.5) & ((fi & 1) == 1))).to(tl.uint32)
+    q = tl.where(e32 < -6, sub, normal)
+    q = tl.minimum(q, 0x7E)
+    q = tl.where(x != x, 0x7F, q | sign)
+    return q.to(tl.uint8)
