+template <long scalar_type_id>
+class MarlinScalarType {};
+
+template <>
+class MarlinScalarType<sglang::host::kFloat16.id()> {
+ public:
+  using scalar_t = half;
+  using scalar_t2 = half2;
+  using scalar_t4 = half2;
+  using scalar_32bit_t = half2;
+
